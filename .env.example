# Copy to apps/web/.env.local for the web app. Worker uses the root .env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
APP_ORIGIN=http://localhost:3000
LLM_PROVIDER=fixture
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_DAILY_SPEND_LIMIT=1
# Required for paid generation: verify the chosen model's current token rates.
LLM_INPUT_USD_PER_MILLION=0.1
LLM_OUTPUT_USD_PER_MILLION=0.5
ENABLE_ADAPTIVE_PRACTICE=false
ENABLE_AI_GENERATION=false
# Browser imports are capped at 512 MiB; larger collections must be exported as subsets.
# ERROR_TRACKING_DSN is intentionally not advertised: logs are structured and redacted,
# but no third-party telemetry provider is connected by default.
