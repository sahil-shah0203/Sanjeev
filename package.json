{
  "name": "recall-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev apps/web --webpack",
    "build": "node scripts/assets.mjs && next build apps/web --webpack && node scripts/build-sw.mjs && node scripts/package-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests scripts docs *.json *.ts *.yml",
    "test:sample": "tsx scripts/inspect-sample.ts",
    "test:performance": "tsx scripts/benchmark.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "postinstall": "node scripts/assets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@zip.js/zip.js": "2.23.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.4.16",
    "fzstd": "0.1.1",
    "katex": "0.19.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sql.js": "1.14.2",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/jsdom": "30.0.0",
    "@types/katex": "0.16.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "pnpm": "10.34.6",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.6"
}
